---
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;

type SteamGame = {
	appid: number;
	name: string;
	playtime_2weeks: number;
	playtime_forever: number;
	img_icon_url: string;
};

// 构建时从 Steam Web API 获取最近游玩数据（需要 STEAM_API_KEY 环境变量）
const apiKey = import.meta.env.STEAM_API_KEY as string | undefined;
const steamId = (import.meta.env.STEAM_ID as string | undefined) || "76561198248501066";

let games: SteamGame[] | null = null;

if (apiKey) {
	try {
		const res = await fetch(
			`https://api.steampowered.com/IPlayerService/GetRecentlyPlayedGames/v1/?key=${apiKey}&steamid=${steamId}&count=8&format=json`,
			{ signal: AbortSignal.timeout(15000) },
		);
		if (res.ok) {
			const json = (await res.json()) as { response?: { games?: SteamGame[] } };
			games = json.response?.games ?? [];
		}
	} catch {
		games = null;
	}
}

const gameIconUrl = (appid: number, hash: string): string =>
	hash
		? `https://media.steampowered.com/steamcommunity/public/images/apps/${appid}/${hash}.jpg`
		: `https://cdn.akamai.steamstatic.com/steam/apps/${appid}/header.jpg`;

const formatHours = (minutes: number): string =>
	minutes > 0 ? `${(minutes / 60).toFixed(1)} 小时` : "未记录";
---

<WidgetLayout
	name="最近在玩"
	showTitle={showTitle}
	id="steam-recent-games"
	class={className}
	style={style}
>
	{games === null ? (
		<p class="text-sm text-neutral-500">
			{apiKey ? "无法获取游玩记录" : "暂未配置 STEAM_API_KEY"}
		</p>
	) : games.length === 0 ? (
		<p class="text-sm text-neutral-500">最近没有游玩记录</p>
	) : (
		<div class="flex flex-col gap-1.5">
			{games.map((game) => (
				<a
					href={`https://store.steampowered.com/app/${game.appid}/`}
					target="_blank"
					rel="noreferrer noopener"
					class="group flex min-w-0 items-center gap-3 rounded-lg p-2
						text-neutral-700/75 dark:text-neutral-300/75
						hover:bg-(--btn-plain-bg-hover) hover:text-(--primary)"
				>
					<img
						src={gameIconUrl(game.appid, game.img_icon_url)}
						alt=""
						loading="lazy"
						class="h-10 w-10 shrink-0 rounded-md object-cover"
					/>
					<div class="flex min-w-0 flex-1 flex-col gap-0.5">
						<span
							class="truncate text-sm font-medium text-neutral-800 dark:text-neutral-100"
						>
							{game.name}
						</span>
						<span class="text-xs text-neutral-500">
							最近两周 {formatHours(game.playtime_2weeks)} · 累计{" "}
							{formatHours(game.playtime_forever)}
						</span>
					</div>
				</a>
			))}
		</div>
	)}
</WidgetLayout>
